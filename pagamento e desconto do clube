// FUNÇÃO PRINCIPAL
int main() {

	pedido novo_pedido;

	printf("=================================\n");
	printf("       SISTEMA DA PADARIA\n");
	printf("=================================\n");

	// Cadastro do cliente
	printf("\nDigite o codigo do pedido: ");
	scanf("%d", &novo_pedido.codigo);

	printf("Digite o nome do cliente: ");
	scanf(" %49[^\n]", novo_pedido.cliente);

	printf("Digite o valor total do pedido: R$ ");
	scanf("%f", &novo_pedido.total_pedido);

	// Inicialização do status
	novo_pedido.status = 0;

	// Chamada do módulo de pagamento
	processar_pagamento(&novo_pedido);

	return 0;
}
