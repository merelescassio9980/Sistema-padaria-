#include <stdio.h>

// Desconto do Clube da Padaria
#define DESCONTO_CLUBE 5.0

// Estrutura do pedido
typedef struct {
	int codigo;
	char cliente[50];
	int quantidades[5];
	float total_pedido;
	int status;
} pedido;

// Função para aplicar desconto
void aplicar_desconto(float *total, float percentual) {
	*total = *total - (*total * percentual / 100.0);
}

// Módulo de pagamento e desconto
void processar_pagamento(pedido *p) {

	int clube;
	int pagamento;
	float valor_original;
	float valor_desconto = 0.0;
	float valor_recebido = 0.0;
	float troco = 0.0;

	if (p == NULL || p->total_pedido < 0) {
		printf("Erro: pedido invalido!\n");
		return;
	}

	valor_original = p->total_pedido;

	printf("\n=================================\n");
	printf("       CLUBE PADARIA\n");
	printf("=================================\n");

	// Verificação do clube
	do {
		printf("\nO cliente participa do clube?\n");
		printf("1 - Sim\n");
		printf("2 - Nao\n");
		printf("Opcao: ");

		if (scanf("%d", &clube) != 1) {
			printf("Entrada invalida!\n");
			while (getchar() != '\n');
			clube = 0;
		}

		if (clube != 1 && clube != 2) {
			printf("Opcao invalida! Tente novamente.\n");
		}

	} while (clube != 1 && clube != 2);

	// Aplicação do desconto
	if (clube == 1) {

		aplicar_desconto(&p->total_pedido,
		                 DESCONTO_CLUBE);

		valor_desconto = valor_original - p->total_pedido;

		printf("\nParabens! Desconto do clube aplicado!\n");

	} else {

		printf("\nCliente sem desconto do clube.\n");
	}

	// Escolha da forma de pagamento
	printf("\n=================================\n");
	printf("         FORMAS DE PAGAMENTO\n");
	printf("=================================\n");

	printf("1 - Dinheiro\n");
	printf("2 - Pix\n");
	printf("3 - Cartao de debito\n");
	printf("4 - Cartao de credito\n");

	do {
		printf("\nEscolha a forma de pagamento: ");

		if (scanf("%d", &pagamento) != 1) {
			printf("Entrada invalida!\n");
			while (getchar() != '\n');
			pagamento = 0;
		}

		if (pagamento < 1 || pagamento > 4) {
			printf("Forma de pagamento invalida!\n");
		}

	} while (pagamento < 1 || pagamento > 4);

	// Processamento do pagamento
	switch (pagamento) {

	case 1:

		printf("\nPagamento em dinheiro.\n");

		do {
			printf("Valor recebido: R$ ");

			if (scanf("%f", &valor_recebido) != 1) {
				printf("Valor invalido!\n");
				while (getchar() != '\n');
				valor_recebido = -1;
				continue;
			}

			if (valor_recebido < p->total_pedido) {
				printf("Valor insuficiente!\n");
				printf("Faltam R$ %.2f\n",
				       p->total_pedido - valor_recebido);
			}

		} while (valor_recebido < p->total_pedido);

		troco = valor_recebido - p->total_pedido;
		break;

	case 2:

		printf("\nPagamento via Pix.\n");
		printf("Valor a transferir: R$ %.2f\n",
		       p->total_pedido);
		break;

	case 3:

		printf("\nPagamento no cartao de debito.\n");
		printf("Valor cobrado: R$ %.2f\n",
		       p->total_pedido);
		break;

	case 4:

		printf("\nPagamento no cartao de credito.\n");
		printf("Valor cobrado: R$ %.2f\n",
		       p->total_pedido);
		break;
	}

	// Resumo final
	printf("\n=================================\n");
	printf("       RESUMO DO PAGAMENTO\n");
	printf("=================================\n");

	printf("Cliente: %s\n", p->cliente);

	printf("Valor original: R$ %.2f\n",
	       valor_original);

	printf("Participante do clube: %s\n",
	       clube == 1 ? "Sim" : "Nao");

	printf("Desconto aplicado: R$ %.2f\n",
	       valor_desconto);

	printf("---------------------------------\n");

	printf("TOTAL A PAGAR: R$ %.2f\n",
	       p->total_pedido);

	if (pagamento == 1) {

		printf("Valor recebido: R$ %.2f\n",
		       valor_recebido);

		printf("Troco: R$ %.2f\n", troco);
	}

	printf("---------------------------------\n");

	printf("Status: Pagamento realizado!\n");

	printf("=================================\n");
}

