
#include <stdio.h>
#include <stdbool.h>
#include <string.h>

#define DESCONTO_CLUBE 5.0

// ESTRUTURA DO CLIENTE
typedef struct Cliente_Clube {
    int codigo;
    char nome[100];
    char cpf[15];
    char telefone[15];
} Cliente_Clube;

// ESTRUTURA DO PEDIDO
typedef struct pedido {
    int codigo;
    int quantidades[5];
    float total_pedido;
    int clube;

    // DADOS PARA O RECIBO
    char cpf_nota[15];
    char nome_cliente[100];
    char cpf_cliente[15];

    float valor_bruto;
    float valor_liquido;
    float desconto;

    int forma_pagamento;

} pedido;

// PROTOTIPOS
void cadastrarClube(Cliente_Clube clientes[], int indice, int *cadastrado);

void Registrarpedido(
    Cliente_Clube clientes[],
    int *indice,
    int *cadastrado,
    char ccpf[15],
    bool cpfdig,
    int Rncpf,
    char ncpf[15],
    pedido pedidos[],
    int *contador
);

void pagamento(pedido *p);

void Relatorio(pedido pedidos[], int contador);

void emitir_recibo(pedido *p);

void aplicar_desconto(float *total, float percentual);


// FUNCAO MENU
void menu(Cliente_Clube clientes[], int *indice, int *cadastrado,
          pedido pedidos[], int *contador) {

    printf("========== MENU PRINCIPAL ==========");

    while (1) {

        int opcao;

        printf("\n1 - Cadastrar pedido\n");
        printf("\n2 - Registrar Pedido\n");
        printf("\n3 - Mostrar Relatorio\n");
        printf("\n4 - Sair\n");
        printf("\n====================================");
        printf("\nEscolha uma opcao: ");

        scanf("%d", &opcao);
        getchar();

        switch (opcao) {

            case 1:

                // Cadastrar clube
                if (*indice < 1000) {

                    cadastrarClube(clientes, *indice, cadastrado);

                    if (*cadastrado == 1) {
                        (*indice)++;
                        *cadastrado = 0;
                    }

                } else {
                    printf("\nLimite de clientes atingido!");
                }

                break;

            case 2:

                // Registrar pedido
                Registrarpedido(clientes, indice, cadastrado,
                    (char[15]){0}, false, 0, (char[15]){0},
                    pedidos, contador);

                pagamento(&pedidos[*contador - 1]);

                emitir_recibo(&pedidos[*contador - 1]);

                break;

            case 3:

                // Mostrar relatorio
                Relatorio(pedidos, *contador);

                break;

            case 4:

                // Sair do sistema
                printf("\nSaindo do sistema...\n");
                return;

            default:

                printf("\nERRO! Opcao invalida!\n");

                break;
        }
    }
}


// FUNCAO DE CADASTRO DO CLUBE
void cadastrarClube(Cliente_Clube clientes[], int indice, int *cadastrado) {

    printf("\n====== CADASTRO CLUBE BELLA MASSA ======\n");

    clientes[indice].codigo = indice + 1;

    printf("Digite seu nome: ");
    scanf(" %99[^\n]", clientes[indice].nome);

    printf("Digite seu CPF: ");
    scanf("%14s", clientes[indice].cpf);

    printf("Digite seu telefone: ");
    scanf("%14s", clientes[indice].telefone);

    *cadastrado = 1;

    printf("\nCliente cadastrado com sucesso!\n");
}


// FUNCAO REGISTRAR PEDIDO
void Registrarpedido(
    Cliente_Clube clientes[],
    int *indice,
    int *cadastrado,
    char ccpf[15],
    bool cpfdig,
    int Rncpf,
    char ncpf[15],
    pedido pedidos[],
    int *contador
) {

    int Rclube;
    int opcao, quantidade;
    int continuar = 1;
    int clube_pedido = 0;

    // Pergunta se o cliente quer o clube da padaria
    printf("\nDeseja por o clube da padaria Bella Massa? (1-sim 2-nao): ");
    scanf("%d", &Rclube);

    if (Rclube == 1) {

        // Verifica se o cliente tem clube
        if (*indice > 0) {

            // Pede para digitar o CPF do clube
            printf("\nDigite o CPF do clube: ");

            while (1) {

                scanf("%14s", ccpf);

                cpfdig = false;

                for (int i = 0; i < *indice; i++) {

                    if (strcmp(ccpf, clientes[i].cpf) == 0) {

                        printf("\nClube inserido no pedido!\n");

                        cpfdig = true;
                        clube_pedido = 1;

                        // Armazena os dados do cliente no pedido
                        strcpy(pedidos[*contador].nome_cliente,
                               clientes[i].nome);

                        strcpy(pedidos[*contador].cpf_cliente,
                               clientes[i].cpf);

                        break;
                    }
                }

                if (cpfdig == true) {
                    break;
                } else {
                    printf("\nSeu CPF do clube esta incorreto, digite novamente: ");
                }
            }

        } else {

            printf("\nVamos cadastrar seu clube...\n");

            if (*indice < 1000) {

                cadastrarClube(clientes, *indice, cadastrado);

                if (*cadastrado == 1) {

                    (*indice)++;

                    *cadastrado = 0;

                    clube_pedido = 1;

                    // Armazena os dados do novo cliente
                    strcpy(pedidos[*contador].nome_cliente,
                           clientes[*indice - 1].nome);

                    strcpy(pedidos[*contador].cpf_cliente,
                           clientes[*indice - 1].cpf);
                }
            }
        }

    } else {

        // Se o cliente nao quiser o clube, pode colocar CPF na nota
        printf("\nDeseja colocar o CPF na nota? (1-sim 2-nao): ");
        scanf("%d", &Rncpf);

        if (Rncpf == 1) {

            printf("\nDigite o seu CPF: ");
            scanf("%14s", ncpf);

            // Armazena o CPF para o recibo
            strcpy(pedidos[*contador].cpf_nota, ncpf);
        }
    }

    printf("\nCadastrar pedido - Bella Massa\n");

    pedidos[*contador].codigo = *contador + 1;

    for (int i = 0; i < 5; i++) {
        pedidos[*contador].quantidades[i] = 0;
    }

    pedidos[*contador].total_pedido = 0;

    // Inicializa os dados do recibo
    pedidos[*contador].cpf_nota[0] = '\0';

    // Registra se o cliente participa do clube
    pedidos[*contador].clube = clube_pedido;

    while (continuar == 1) {

        // Lista dos produtos
        printf("\nProdutos:\n");
        printf("1 - Pao frances (R$ 0,80)\n");
        printf("2 - Bolo (R$ 8,00)\n");
        printf("3 - Pao de queijo (R$ 3,00)\n");
        printf("4 - Minipizza (R$ 6,00)\n");
        printf("5 - Minichurros (R$ 5,00)\n");

        printf("\nDigite o ID do produto (1-5): ");
        scanf("%d", &opcao);

        if (opcao < 1 || opcao > 5) {
            printf("Produto invalido!\n");
            continue;
        }

        printf("Digite a quantidade: ");
        scanf("%d", &quantidade);

        if (quantidade <= 0) {
            printf("Quantidade invalida!\n");
            continue;
        }

        // Calcula o valor da compra
        pedidos[*contador].quantidades[opcao - 1] += quantidade;

        switch (opcao) {

            case 1:
                pedidos[*contador].total_pedido += quantidade * 0.80;
                break;

            case 2:
                pedidos[*contador].total_pedido += quantidade * 8.00;
                break;

            case 3:
                pedidos[*contador].total_pedido += quantidade * 3.00;
                break;

            case 4:
                pedidos[*contador].total_pedido += quantidade * 6.00;
                break;

            case 5:
                pedidos[*contador].total_pedido += quantidade * 5.00;
                break;
        }

        // Pergunta se deseja adicionar mais um produto
        printf("\nDeseja adicionar outro produto?\n");
        printf("1 - Sim\n");
        printf("2 - Nao\n");
        printf("Opcao: ");
        scanf("%d", &continuar);

        if (continuar != 1) {
            continuar = 2;
        }
    }

    printf("\n====== RESUMO DO PEDIDO ======\n");

    printf("Codigo do pedido: %d\n",
           pedidos[*contador].codigo);

    printf("Total do pedido: R$ %.2f\n",
           pedidos[*contador].total_pedido);

    printf("\nPedido registrado com sucesso!\n");

    (*contador)++;
}


// FUNCAO PARA APLICAR DESCONTO
void aplicar_desconto(float *total, float percentual) {

    *total = *total - (*total * percentual / 100.0);
}


// MODULO DE PAGAMENTO E DESCONTO
void pagamento(pedido *p) {

    int forma_pagamento;
    float valor_original;
    float valor_desconto = 0.0;
    float valor_recebido = 0.0;
    float troco = 0.0;

    if (p == NULL || p->total_pedido < 0) {
        printf("Erro: pedido invalido!\n");
        return;
    }

    valor_original = p->total_pedido;

    // Armazena o valor bruto
    p->valor_bruto = valor_original;

    printf("\n=================================\n");
    printf("       CLUBE PADARIA\n");
    printf("=================================\n");

    // Verificacao automatica do clube
    if (p->clube == 1) {

        aplicar_desconto(&p->total_pedido,
                         DESCONTO_CLUBE);

        valor_desconto = valor_original - p->total_pedido;

        printf("\nParabens! Desconto do clube aplicado!\n");

        printf("Valor liquido com desconto: R$ %.2f\n",
               p->total_pedido);

    } else {

        printf("\nCliente sem desconto do clube.\n");
    }

    // Armazena os valores para o recibo
    p->valor_liquido = p->total_pedido;
    p->desconto = valor_desconto;

    // Escolha da forma de pagamento
    printf("\n=================================\n");
    printf("         FORMAS DE PAGAMENTO\n");
    printf("=================================\n");

    printf("1 - Dinheiro\n");
    printf("2 - Pix\n");
    printf("3 - Cartao de debito\n");
    printf("4 - Cartao de credito\n");

    do {

        printf("\nEscolha a forma de pagamento: ");

        if (scanf("%d", &forma_pagamento) != 1) {

            printf("Entrada invalida!\n");

            while (getchar() != '\n');

            forma_pagamento = 0;
        }

        if (forma_pagamento < 1 || forma_pagamento > 4) {
            printf("Forma de pagamento invalida!\n");
        }

    } while (forma_pagamento < 1 || forma_pagamento > 4);

    // Armazena a forma de pagamento
    p->forma_pagamento = forma_pagamento;

    // Processamento do pagamento
    switch (forma_pagamento) {

        case 1:

            printf("\nPagamento em dinheiro.\n");

            do {

                printf("Valor recebido: R$ ");

                if (scanf("%f", &valor_recebido) != 1) {

                    printf("Valor invalido!\n");

                    while (getchar() != '\n');

                    valor_recebido = -1;

                    continue;
                }

                if (valor_recebido < p->total_pedido) {

                    printf("Valor insuficiente!\n");

                    printf("Faltam R$ %.2f\n",
                           p->total_pedido - valor_recebido);
                }

            } while (valor_recebido < p->total_pedido);

            troco = valor_recebido - p->total_pedido;

            break;

        case 2:

            printf("\nPagamento via Pix.\n");

            printf("Valor a transferir: R$ %.2f\n",
                   p->total_pedido);

            break;

        case 3:

            printf("\nPagamento no cartao de debito.\n");

            printf("Valor cobrado: R$ %.2f\n",
                   p->total_pedido);

            break;

        case 4:

            printf("\nPagamento no cartao de credito.\n");

            printf("Valor cobrado: R$ %.2f\n",
                   p->total_pedido);

            break;
    }

    // Resumo final
    printf("\n=================================\n");
    printf("       RESUMO DO PAGAMENTO\n");
    printf("=================================\n");

    printf("Valor original: R$ %.2f\n",
           valor_original);

    printf("Participante do clube: %s\n",
           p->clube == 1 ? "Sim" : "Nao");

    printf("Desconto aplicado: R$ %.2f\n",
           valor_desconto);

    printf("---------------------------------\n");

    printf("TOTAL A PAGAR: R$ %.2f\n",
           p->total_pedido);

    if (forma_pagamento == 1) {

        printf("Valor recebido: R$ %.2f\n",
               valor_recebido);

        printf("Troco: R$ %.2f\n", troco);
    }

    printf("---------------------------------\n");

    printf("Status: Pagamento realizado!\n");

    printf("=================================\n");
}


// FUNCAO PARA EMITIR O RECIBO
void emitir_recibo(pedido *p) {

    static int numero_recibo = 1;

    if (p == NULL) {
        printf("\nNao foi possivel emitir o recibo.\n");
        return;
    }

    char *produtos[5] = {
        "Pao frances",
        "Bolo",
        "Pao de queijo",
        "Minipizza",
        "Minichurros"
    };

    char *formas_pagamento[4] = {
        "Dinheiro",
        "Pix",
        "Cartao de debito",
        "Cartao de credito"
    };

    printf("\n");
    printf("========================================\n");
    printf("          PADARIA BELLA MASSA\n");
    printf("          RECIBO DE PAGAMENTO\n");
    printf("========================================\n");

    printf("Recibo numero: %04d\n", numero_recibo++);
    printf("Pedido numero: %d\n", p->codigo);

    printf("----------------------------------------\n");

    // DADOS DO CLIENTE
    if (p->clube == 1) {

        printf("CLIENTE CLUBE BELLA MASSA\n");
        printf("Nome: %s\n", p->nome_cliente);
        printf("CPF: %s\n", p->cpf_cliente);

    } else if (p->cpf_nota[0] != '\0') {

        printf("CPF NA NOTA: %s\n", p->cpf_nota);
    }

    printf("----------------------------------------\n");
    printf("PRODUTOS COMPRADOS:\n");

    // Lista os produtos e suas quantidades
    for (int i = 0; i < 5; i++) {

        if (p->quantidades[i] > 0) {

            printf("%-20s %d unidades\n",
                   produtos[i],
                   p->quantidades[i]);
        }
    }

    printf("----------------------------------------\n");

    // VALORES DO PEDIDO
    printf("Valor bruto: R$ %.2f\n",
           p->valor_bruto);

    printf("Desconto aplicado: R$ %.2f\n",
           p->desconto);

    printf("Valor liquido: R$ %.2f\n",
           p->valor_liquido);

    printf("----------------------------------------\n");

    // FORMA DE PAGAMENTO
    printf("Forma de pagamento: %s\n",
           formas_pagamento[p->forma_pagamento - 1]);

    printf("----------------------------------------\n");

    printf("TOTAL PAGO: R$ %.2f\n",
           p->valor_liquido);

    printf("----------------------------------------\n");
    printf("       OBRIGADO PELA PREFERENCIA!\n");
    printf("========================================\n");
}


// RELATORIO DE VENDAS
void Relatorio(pedido pedidos[], int contador) {

    printf("\n====== RELATORIO DE VENDAS ======\n");

    if (contador == 0) {
        printf("Nenhum pedido foi realizado ainda.\n");
        return;
    }

    float faturamento_total = 0.0f;
    int total_produtos[5] = {0, 0, 0, 0, 0};

    // Percorre todos os pedidos realizados
    for (int i = 0; i < contador; i++) {

        faturamento_total += pedidos[i].total_pedido;

        // Soma a quantidade de cada produto vendido
        for (int j = 0; j < 5; j++) {
            total_produtos[j] += pedidos[i].quantidades[j];
        }
    }

    printf("\nTotal de pedidos realizados: %d\n", contador);

    printf("Faturamento total: R$ %.2f\n", faturamento_total);

    printf("\n====== VENDAS POR PRODUTO ======\n");

    printf("1 - Pao frances: %d unidades\n", total_produtos[0]);
    printf("2 - Bolo: %d unidades\n", total_produtos[1]);
    printf("3 - Pao de queijo: %d unidades\n", total_produtos[2]);
    printf("4 - Minipizza: %d unidades\n", total_produtos[3]);
    printf("5 - Minichurros: %d unidades\n", total_produtos[4]);

    printf("\n================================\n");
}


// MAIN
int main() {

    Cliente_Clube clientes[1000];
    pedido pedidos[1000];

    int indice = 0;
    int cadastrado = 0;
    int contador = 0;

    printf("====== SEJA BEM VINDO(A) A BELLA MASSA ======\n");

    // Chama a funcao menu
    menu(clientes, &indice, &cadastrado, pedidos, &contador);

    return 0;
}
