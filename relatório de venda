//relatorio de vendas
void Relatorio(pedido pedidos[], int contador) {
    printf("\n====== RELATORIO DE VENDAS ======\n");

    if (contador == 0) {
        printf("Nenhum pedido foi realizado ainda.\n");
        return;
    }

    float faturamento_total = 0.0f;
    int total_produtos[5] = {0, 0, 0, 0, 0};

    // Percorre todos os pedidos ja realizados (de 0 ate contador - 1)
    for (int i = 0; i < contador; i++) {
        faturamento_total += pedidos[i].total_pedido;

        for (int j = 0; j < 5; j++) {
            total_produtos[j] += pedidos[i].quantidades[j];
        }
    }

    printf("Total de pedidos realizados: %d\n", contador);
    printf("Total de vendas: R$ %.2f\n", faturamento_total);
    printf("====== VENDAS POR PRODUTO ==========\n");
    printf("1 - Pao frances: %d unidades\n", total_produtos[0]);
    printf("2 - Bolo: %d unidades\n", total_produtos[1]);
    printf("3 - Pao de queijo: %d unidades\n", total_produtos[2]);
    printf("4 - Minipizza: %d unidades\n", total_produtos[3]);
    printf("5 - Minichurros: %d unidades\n", total_produtos[4]);
}



